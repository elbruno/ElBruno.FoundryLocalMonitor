<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Catppuccin Mocha dark palette -->
    <SolidColorBrush x:Key="SurfaceBrush"    Color="#1E1E2E"/>
    <SolidColorBrush x:Key="MantelBrush"     Color="#181825"/>
    <SolidColorBrush x:Key="OverlayBrush"    Color="#313244"/>
    <SolidColorBrush x:Key="SurfaceMidBrush" Color="#45475A"/>
    <SolidColorBrush x:Key="TextBrush"       Color="#CDD6F4"/>
    <SolidColorBrush x:Key="SubtextBrush"    Color="#A6ADC8"/>
    <SolidColorBrush x:Key="MutedBrush"      Color="#6C7086"/>
    <SolidColorBrush x:Key="AccentBrush"     Color="#89B4FA"/>
    <SolidColorBrush x:Key="GreenBrush"      Color="#A6E3A1"/>
    <SolidColorBrush x:Key="RedBrush"        Color="#F38BA8"/>
    <SolidColorBrush x:Key="WarnBrush"       Color="#FAB387"/>
    <!-- Text on accent/colored buttons: dark bg contrasts with light-colored buttons in dark theme -->
    <SolidColorBrush x:Key="OnAccentBrush"   Color="#1E1E2E"/>

</ResourceDictionary>
