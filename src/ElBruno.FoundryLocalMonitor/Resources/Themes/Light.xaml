<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Clean light palette -->
    <SolidColorBrush x:Key="SurfaceBrush"    Color="#F5F5F5"/>
    <SolidColorBrush x:Key="MantelBrush"     Color="#EBEBEB"/>
    <SolidColorBrush x:Key="OverlayBrush"    Color="#E2E2E2"/>
    <SolidColorBrush x:Key="SurfaceMidBrush" Color="#C8C8D8"/>
    <SolidColorBrush x:Key="TextBrush"       Color="#1A1A2E"/>
    <SolidColorBrush x:Key="SubtextBrush"    Color="#4A4A6A"/>
    <SolidColorBrush x:Key="MutedBrush"      Color="#8A8A9A"/>
    <SolidColorBrush x:Key="AccentBrush"     Color="#1E66F5"/>
    <SolidColorBrush x:Key="GreenBrush"      Color="#40A02B"/>
    <SolidColorBrush x:Key="RedBrush"        Color="#D20F39"/>
    <SolidColorBrush x:Key="WarnBrush"       Color="#E6893A"/>
    <!-- Text on accent/colored buttons: light bg contrasts with dark-colored buttons in light theme -->
    <SolidColorBrush x:Key="OnAccentBrush"   Color="#FFFFFF"/>

</ResourceDictionary>
