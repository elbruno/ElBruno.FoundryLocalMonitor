<Window x:Class="ElBruno.FoundryLocalMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ElBruno.FoundryLocalMonitor.ViewModels"
        Title="Foundry Local Monitor"
        Height="650" Width="950"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}">

    <DockPanel>
        <!-- Header bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource OverlayBrush}" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource RedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource GreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Foundry Local Monitor" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                           Foreground="{DynamicResource SubtextBrush}"
                           FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- Main tab area -->
        <TabControl Background="{DynamicResource SurfaceBrush}" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                    <Setter Property="Padding" Value="12,6"/>
                </Style>
            </TabControl.Resources>

            <!-- Status tab -->
            <TabItem Header="Status">
                <StackPanel Margin="20">
                    <!-- Service status row -->
                    <TextBlock Text="Service Status" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="13"
                               Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding EndpointText}" FontSize="12"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="Consolas" Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Discovered instances -->
                    <TextBlock Text="Detected Foundry Local Instances" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="No instances detected yet — waiting for discovery…"
                               Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DiscoveredInstances.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding DiscoveredInstances}" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource OverlayBrush}"
                                        BorderBrush="{DynamicResource SurfaceMidBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="12,8" Margin="0,0,0,4">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Border Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="3" Padding="6,2" Margin="4,0,0,0"
                                                    Visibility="{Binding IsDaemon, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="daemon" FontSize="10"
                                                           Foreground="{DynamicResource OnAccentBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource WarnBrush}"
                                                    CornerRadius="3" Padding="6,2" Margin="4,0,0,0"
                                                    Visibility="{Binding IsProxy, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="sdk proxy" FontSize="10"
                                                           Foreground="{DynamicResource OnAccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding BaseUrl}" FontSize="13"
                                                       FontFamily="Consolas"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource SubtextBrush}">
                                                <Run Text="Process: "/>
                                                <Run Text="{Binding ProcessName, TargetNullValue='unknown'}"/>
                                                <Run Text="   Port: "/>
                                                <Run Text="{Binding Port}"/>
                                                <Run Text="   PID: "/>
                                                <Run Text="{Binding Pid, TargetNullValue='?'}"/>
                                            </TextBlock>
                                            <DockPanel Margin="0,2,0,0">
                                                <Button DockPanel.Dock="Left"
                                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        CommandParameter="{Binding ProcessPath}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="0,0,4,0" Cursor="Hand"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Open folder in Explorer">
                                                    <TextBlock Text="📂" FontSize="11"
                                                               Foreground="{DynamicResource MutedBrush}"/>
                                                </Button>
                                                <TextBlock FontSize="10"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ProcessPath}"
                                                           Text="{Binding ProcessPath, TargetNullValue='path unavailable'}"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                            Width="100" HorizontalAlignment="Left"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource OnAccentBrush}"
                            BorderThickness="0" Padding="8,4" Cursor="Hand"/>
                </StackPanel>
            </TabItem>

            <!-- Loaded Models tab -->
            <TabItem Header="Loaded Models">
                <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Loaded Models by Instance" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Each card is one OS process using Foundry Local."
                                   FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding GroupedInstances}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource OverlayBrush}"
                                            BorderBrush="{DynamicResource SurfaceMidBrush}"
                                            BorderThickness="1" CornerRadius="4"
                                            Padding="12,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="3" Padding="6,2" Margin="4,0,0,0"
                                                            Visibility="{Binding IsDaemon, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="daemon" FontSize="10" Foreground="{DynamicResource OnAccentBrush}"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource WarnBrush}"
                                                            CornerRadius="3" Padding="6,2" Margin="4,0,0,0"
                                                            Visibility="{Binding IsProxy, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="sdk proxy" FontSize="10" Foreground="{DynamicResource OnAccentBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding PortsLabel, StringFormat='Ports: {0}'}"
                                                       FontSize="11" Foreground="{DynamicResource SubtextBrush}" Margin="0,4,0,0"/>
                                             <DockPanel Margin="0,2,0,0">
                                               <Button DockPanel.Dock="Left"
                                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        CommandParameter="{Binding ProcessPath}"
                                                        Background="Transparent" BorderThickness="0"
                                                       Padding="0,0,4,0" Cursor="Hand"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Open folder in Explorer">
                                                    <TextBlock Text="📂" FontSize="11"
                                                               Foreground="{DynamicResource MutedBrush}"/>
                                                </Button>
                                                <TextBlock FontSize="10"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ProcessPath}"
                                                           Text="{Binding ProcessPath, TargetNullValue='path unavailable'}"/>
                                            </DockPanel>
                                            <!-- Model list — flat ItemsControl, no BoolToVisibility, no Run bindings -->
                                            <Rectangle Height="1" Fill="{DynamicResource SurfaceMidBrush}" Margin="0,8,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Models}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,3,0,0">
                                                           <!-- Device badge — left column -->
                                                           <Border DockPanel.Dock="Left"
                                                                   Background="{Binding Device, Converter={StaticResource DeviceToColor}}"
                                                                   CornerRadius="2" Padding="5,1" Margin="0,0,8,0"
                                                                   VerticalAlignment="Center" MinWidth="52">
                                                               <TextBlock FontSize="9" Foreground="White" FontWeight="SemiBold"
                                                                          HorizontalAlignment="Center"
                                                                          Text="{Binding Device, TargetNullValue='?'}"/>
                                                           </Border>
                                                           <!-- Source port — right column, muted -->
                                                           <TextBlock DockPanel.Dock="Right"
                                                                      FontSize="9" Foreground="{DynamicResource MutedBrush}"
                                                                      VerticalAlignment="Center" Margin="6,0,0,0"
                                                                      FontFamily="Consolas"
                                                                      Text="{Binding SourceEndpoint, Converter={StaticResource EndpointToPort}}"/>
                                                           <!-- Model alias — fills remaining space -->
                                                           <TextBlock FontSize="11"
                                                                      Foreground="{DynamicResource SubtextBrush}"
                                                                      VerticalAlignment="Center"
                                                                      TextTrimming="CharacterEllipsis"
                                                                      ToolTip="{Binding ModelId}"
                                                                      Text="{Binding Alias}"/>
                                                       </DockPanel>
                                                   </DataTemplate>
                                               </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Available Models tab -->
            <TabItem Header="Available Models">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Available Models" FontSize="15"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1"
                               Text="Models downloaded to your local cache and ready to load into memory."
                               FontSize="12" Foreground="{DynamicResource SubtextBrush}"
                               Margin="0,0,0,12"/>
                    <ListView Grid.Row="2" ItemsSource="{Binding AvailableModels}"
                              Background="{DynamicResource OverlayBrush}"
                              BorderThickness="0"
                              Foreground="{DynamicResource TextBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Model ID" DisplayMemberBinding="{Binding ModelId}" Width="300"/>
                                <GridViewColumn Header="Alias" DisplayMemberBinding="{Binding Alias}" Width="200"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
