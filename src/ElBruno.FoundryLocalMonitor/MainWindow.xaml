<Window x:Class="ElBruno.FoundryLocalMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ElBruno.FoundryLocalMonitor.ViewModels"
        Title="Foundry Local Monitor"
        Height="650" Width="950"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}">

    <DockPanel>
        <!-- Header bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource OverlayBrush}" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource RedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource GreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Foundry Local Monitor" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                           Foreground="{DynamicResource SubtextBrush}"
                           FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- Main tab area -->
        <TabControl Background="{DynamicResource SurfaceBrush}" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                    <Setter Property="Padding" Value="12,6"/>
                </Style>
            </TabControl.Resources>

            <!-- Status tab -->
            <TabItem Header="Status">
                <StackPanel Margin="20">
                    <!-- Service status row -->
                    <TextBlock Text="Service Status" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="13"
                               Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding EndpointText}" FontSize="12"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="Consolas" Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Discovered instances -->
                    <TextBlock Text="Detected Foundry Local Instances" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="No instances detected yet — waiting for discovery…"
                               Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DiscoveredInstances.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding DiscoveredInstances}" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource OverlayBrush}"
                                        BorderBrush="{DynamicResource SurfaceMidBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="12,8" Margin="0,0,0,4">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Border Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="3" Padding="6,2" Margin="4,0,0,0"
                                                    Visibility="{Binding IsDaemon, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="daemon" FontSize="10"
                                                           Foreground="{DynamicResource OnAccentBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource WarnBrush}"
                                                    CornerRadius="3" Padding="6,2" Margin="4,0,0,0"
                                                    Visibility="{Binding IsProxy, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="sdk proxy" FontSize="10"
                                                           Foreground="{DynamicResource OnAccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding BaseUrl}" FontSize="13"
                                                       FontFamily="Consolas"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource SubtextBrush}">
                                                <Run Text="Process: "/>
                                                <Run Text="{Binding ProcessName, TargetNullValue='unknown'}"/>
                                                <Run Text="   Port: "/>
                                                <Run Text="{Binding Port}"/>
                                                <Run Text="   PID: "/>
                                                <Run Text="{Binding Pid, TargetNullValue='?'}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ProcessPath}"
                                                       Text="{Binding ProcessPath, TargetNullValue='path unavailable'}"
                                                       MaxWidth="400"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                            Width="100" HorizontalAlignment="Left"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource OnAccentBrush}"
                            BorderThickness="0" Padding="8,4" Cursor="Hand"/>
                </StackPanel>
            </TabItem>

            <!-- Loaded Models tab -->
            <TabItem Header="Loaded Models">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Loaded Models by Instance" FontSize="15"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="0" Text="Each card is one OS process. Same PID = same process even if it listens on multiple ports."
                               FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,28,0,0"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding GroupedInstances}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource OverlayBrush}"
                                            BorderBrush="{DynamicResource SurfaceMidBrush}"
                                            BorderThickness="1" CornerRadius="4"
                                            Padding="14,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <!-- Instance header -->
                                            <DockPanel Margin="0,0,0,4">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Border Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="3" Padding="6,2" Margin="4,0,0,0"
                                                            Visibility="{Binding IsDaemon, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="daemon" FontSize="10"
                                                                   Foreground="{DynamicResource OnAccentBrush}"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource WarnBrush}"
                                                            CornerRadius="3" Padding="6,2" Margin="4,0,0,0"
                                                            Visibility="{Binding IsProxy, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="sdk proxy" FontSize="10"
                                                                   Foreground="{DynamicResource OnAccentBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource SubtextBrush}" Margin="0,2,0,0">
                                                        <Run Text="Ports: "/>
                                                        <Run Text="{Binding PortsLabel}" FontFamily="Consolas"/>
                                                        <Run Text="   "/>
                                                        <Run Text="{Binding ModelCount}" FontWeight="SemiBold"/>
                                                        <Run Text=" model(s) loaded"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ProcessPath}"
                                                               Text="{Binding ProcessPath, TargetNullValue='path unavailable'}"
                                                               MaxWidth="700" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <Separator Background="{DynamicResource SurfaceMidBrush}" Margin="0,6,0,6"/>

                                            <!-- Column headers -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Model ID"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock Grid.Column="1" Text="Alias"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock Grid.Column="2" Text="Device"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </Grid>

                                            <!-- Model rows -->
                                            <ItemsControl ItemsSource="{Binding Models}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="220"/>
                                                                <ColumnDefinition Width="160"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ModelId}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontFamily="Consolas" FontSize="12"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Alias}"
                                                                       Foreground="{DynamicResource SubtextBrush}"
                                                                       FontSize="12"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Device}"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       FontSize="11" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Device}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- No models placeholder -->
                                            <TextBlock Text="No models loaded in this instance"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       FontStyle="Italic" FontSize="12" Margin="0,2">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasModels}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Available Models tab -->
            <TabItem Header="Available Models">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Available Models" FontSize="15"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1"
                               Text="Models downloaded to your local cache and ready to load into memory."
                               FontSize="12" Foreground="{DynamicResource SubtextBrush}"
                               Margin="0,0,0,12"/>
                    <ListView Grid.Row="2" ItemsSource="{Binding AvailableModels}"
                              Background="{DynamicResource OverlayBrush}"
                              BorderThickness="0"
                              Foreground="{DynamicResource TextBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Model ID" DisplayMemberBinding="{Binding ModelId}" Width="300"/>
                                <GridViewColumn Header="Alias" DisplayMemberBinding="{Binding Alias}" Width="200"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
