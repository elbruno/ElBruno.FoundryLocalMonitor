<Window x:Class="ElBruno.FoundryLocalMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — Foundry Local Monitor"
        Width="460"         Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource OverlayBrush}" Padding="16,12">
            <TextBlock Text="⚙ Settings" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
        </Border>

        <!-- Footer buttons -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource OverlayBrush}" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Save" Width="80" Height="30" Margin="8,0,0,0"
                        Background="{DynamicResource GreenBrush}"
                        Foreground="{DynamicResource OnAccentBrush}"
                        BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="Save_Click"/>
                <Button DockPanel.Dock="Right" Content="Cancel" Width="80" Height="30"
                        Background="{DynamicResource SurfaceMidBrush}"
                        Foreground="{DynamicResource TextBrush}"
                        BorderThickness="0" Cursor="Hand" Click="Cancel_Click"/>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Polling -->
                <TextBlock Text="Polling" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>

                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Text="Refresh interval (seconds):"
                               Foreground="{DynamicResource TextBrush}" Width="220" VerticalAlignment="Center"/>
                    <TextBox x:Name="PollingIntervalBox" Width="80" HorizontalAlignment="Left"
                             Background="{DynamicResource OverlayBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource SurfaceMidBrush}"
                             Padding="6,4"/>
                </DockPanel>

                <!-- Endpoint -->
                <TextBlock Text="Foundry Local Endpoint" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,8"/>

                <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="Endpoint URL override:"
                               Foreground="{DynamicResource TextBrush}" Width="220" VerticalAlignment="Center"/>
                    <TextBox x:Name="EndpointBox" Width="180" HorizontalAlignment="Left"
                             Background="{DynamicResource OverlayBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource SurfaceMidBrush}"
                             Padding="6,4"/>
                </DockPanel>
                <TextBlock Text="Leave blank to use default (http://localhost:5273)"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,12"/>

                <!-- Notifications -->
                <TextBlock Text="Notifications" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,8"/>

                <CheckBox x:Name="NotifyOnLoadBox" Content="Show notification when model loads"
                          Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>

                <CheckBox x:Name="NotifyOnUnloadBox" Content="Show notification when model unloads"
                          Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>

                <DockPanel Margin="0,4,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="Notify on changes from:"
                               Foreground="{DynamicResource TextBrush}" Width="220" VerticalAlignment="Center"/>
                    <ComboBox x:Name="NotificationFilterBox" Width="160" HorizontalAlignment="Left"
                              Background="{DynamicResource OverlayBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              BorderBrush="{DynamicResource SurfaceMidBrush}">
                        <ComboBoxItem Content="Daemon only"/>
                        <ComboBoxItem Content="All instances"/>
                        <ComboBoxItem Content="None"/>
                    </ComboBox>
                </DockPanel>
                <TextBlock Text="'Daemon only' alerts when external apps load models via Foundry Local."
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,8"
                           TextWrapping="Wrap"/>

                <!-- Startup -->
                <TextBlock Text="Startup" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,8"/>

                <CheckBox x:Name="StartMinimizedBox" Content="Start minimized to tray"
                          Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>

                <!-- Appearance -->
                <TextBlock Text="Appearance" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,8"/>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="Theme:"
                               Foreground="{DynamicResource TextBrush}" Width="220" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ThemeBox" Width="120" HorizontalAlignment="Left"
                              Background="{DynamicResource OverlayBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              BorderBrush="{DynamicResource SurfaceMidBrush}">
                        <ComboBoxItem Content="System"/>
                        <ComboBoxItem Content="Dark"/>
                        <ComboBoxItem Content="Light"/>
                    </ComboBox>
                </DockPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
